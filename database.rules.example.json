{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "luci": {
      ".read": "auth != null",
      "$room": {
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || auth.uid === 'UID_DISPOZITIV')",
        "releu": { ".write": "auth != null", ".validate": "newData.isBoolean()" },
        "led_on": { ".write": "auth != null", ".validate": "newData.isBoolean()" },
        "led_brightness": { ".write": "auth != null", ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5" }
      }
    }
  }
}
